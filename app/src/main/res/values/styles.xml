<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="AppTheme" parent="AppThemeBase">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/water_primary</item>
        <item name="android:colorPrimary">@color/water_primary</item>
        <item name="android:colorPrimaryDark">@color/water_background</item>
        <item name="android:colorControlNormal">@color/water_text_secondary</item>
        <item name="android:colorControlActivated">@color/water_primary</item>
        <item name="android:colorControlHighlight">@color/water_control_highlight</item>
        <item name="android:colorButtonNormal">@color/water_primary_container</item>
        <item name="android:colorError">@color/water_error</item>
        <item name="android:colorBackground">@color/water_background</item>
        <item name="android:colorBackgroundFloating">@color/water_surface</item>
        <item name="android:colorForeground">@color/water_text</item>
        <item name="android:textColorPrimary">@color/water_text</item>
        <item name="android:textColorSecondary">@color/water_text_secondary</item>
        <item name="android:textColorTertiary">@color/water_text_secondary</item>
        <item name="android:textColorHint">@color/water_text_secondary</item>
        <item name="android:textColorHighlight">@color/water_primary_container</item>
        <item name="android:colorEdgeEffect">@color/water_primary</item>
        <item name="android:windowBackground">@color/water_background</item>
        <item name="android:statusBarColor">@color/water_background</item>
        <item name="android:navigationBarColor">@color/water_background</item>
        <item name="android:windowLightStatusBar">@bool/water_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/water_light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
